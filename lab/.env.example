# Copy to lab/.env and edit. lab/.env is gitignored; this template holds no working secret.
#
# The compose stack reads these. The two role passwords are opt-in on purpose: leave them
# blank and lab_analysis / lab_ingest stay NOLOGIN, which is what you want until something
# actually has to connect. Set one and 002_pilot_roles.sh grants LOGIN with exactly it.
POSTGRES_DB=lab
POSTGRES_USER=lab_admin
POSTGRES_PASSWORD=change-me-not-a-real-secret
ANALYSIS_PASSWORD=
INGEST_PASSWORD=
PGPORT=5432

# The database image tracks a mutable tag by default. Set this to a digest or a dated tag
# for anything you want to reproduce later.
# TIMESCALE_IMAGE=timescale/timescaledb:latest-pg16

# The R enrichment step is not in the compose stack: it needs R with DBI and RPostgres plus
# a libpq client. Run it on a host that has those, with the libpq variables set:
#   PGHOST=127.0.0.1 PGPORT=5432 PGDATABASE=lab PGUSER=lab_analysis PGPASSWORD=$ANALYSIS_PASSWORD
#
# The pipeline service needs none of this: it reads synthetic data and writes a report.
